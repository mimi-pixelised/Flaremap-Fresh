{
  "name": "flaremap-native",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "native:build": "node scripts/build-native.mjs",
    "native:assets": "node scripts/prepare-native-assets.mjs",
    "native:sync": "npm run native:build && npx cap sync",
    "native:android": "npm run native:sync && npx cap open android",
    "native:ios": "npm run native:sync && npx cap open ios",
    "test:native": "node --test tests/native.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/local-notifications": "^8.0.0",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/assets": "^4.0.0",
    "esbuild": "^0.25.0"
  }
}
